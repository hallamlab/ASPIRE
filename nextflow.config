params.homeDir = System.getProperty('user.home')
params.workDir = System.getenv('NXF_WORK') ?: "${params.homeDir}/.nextflow/work"
params.condaCacheDir = System.getenv('NXF_CONDA_CACHEDIR') ?: "${params.workDir}/conda"

workDir = params.workDir

conda {
    enabled  = true
    useMamba = true
    cacheDir = params.condaCacheDir
    createTimeout = '2h'
}

// Failed sessions can notify trace observers more than once. Permit the
// second notification to refresh the same run artifacts instead of emitting
// misleading file-exists warnings after the primary task error.
report.overwrite = true
timeline.overwrite = true
trace.overwrite = true
dag.overwrite = true
